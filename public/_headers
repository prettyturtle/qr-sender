# Deployment headers for static hosts that read this file (Cloudflare Pages,
# Netlify). The meta tag in the HTML covers hosts that do not — but frame-ancestors
# and HSTS are header-only, so they live here.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; frame-src blob:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), interest-cohort=()

# Netlify infers this one as application/octet-stream, which makes browsers
# ignore the web app manifest and refuse to offer installation.
/manifest.webmanifest
  Content-Type: application/manifest+json

/*.wasm
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable
